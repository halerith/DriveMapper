<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Add these for self-contained single-file deployment -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>

    <AssemblyTitle>Halerith DriveMapper - Setup</AssemblyTitle>
    <ApplicationIcon>../Assets/installer.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="../Assets/installer.ico" Link="installer.ico" />
    <EmbeddedResource Include="..\Assets\install.config.json" LogicalName="install.config.json" />
    <EmbeddedResource Include="$(PayloadManifestPath)" LogicalName="DriveMapper.PayloadManifest.json" Condition="'$(PayloadManifestPath)' != ''" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="TaskScheduler" Version="2.12.2" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.15" />
    <Compile Include="../Shared/Product.cs" Link="Product.cs" />
  </ItemGroup>
</Project>
